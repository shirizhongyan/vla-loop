+class FlowMatchingActionHead(nn.Module):
+    """
+    Action head that generates continuous actions via flow matching.
+
+    Follows the rectified-flow formulation used by pi0: a straight path is defined
+    between the ground-truth action and Gaussian noise, and the network regresses the
+    constant velocity field along that path.
+
+        x_t = (1 - t) * a + t * eps,    u_t = eps - a
+
+    Training samples t ~ Beta(1.5, 1) and minimizes the squared error between the
+    predicted and target velocity. Inference integrates the predicted velocity with
+    an Euler step, going from t = 1 (pure noise) down to t = 0 (action).
+
+    The noisy-action interface matches DiffusionActionHead, so the same projector and
+    the same LLM token layout are reused.
+    """
+
+    def __init__(
+        self,
+        input_dim=4096,
+        hidden_dim=4096,
+        action_dim=7,
+        num_inference_steps=10,
+        time_beta_alpha=1.5,
+        time_beta_beta=1.0,
+    ):
+        super().__init__()
+        self.action_dim = action_dim
+        self.num_inference_steps = num_inference_steps
+        self.time_beta_alpha = time_beta_alpha
+        self.time_beta_beta = time_beta_beta
+        self.velocity_predictor = NoisePredictionModel(
+            transformer_hidden_dim=hidden_dim * ACTION_DIM, hidden_dim=hidden_dim, action_dim=action_dim
+        )
+        self.time_encoder = SinusoidalPositionalEncoding(dim=hidden_dim)
+
+    def sample_noisy_actions(self, ground_truth_actions):
+        """
+        Sample a point on the straight path between noise and the ground-truth action.
+
+        Returns the interpolated state, the target velocity, and the time embedding.
+        """
+        batch_size = ground_truth_actions.shape[0]
+        device = ground_truth_actions.device
+        noise = torch.randn(
+            size=(batch_size, NUM_ACTIONS_CHUNK, ACTION_DIM),
+            device=device,
+            dtype=ground_truth_actions.dtype,
+        )
+        # Beta(1.5, 1) concentrates samples near t = 1 (the noisy end), matching pi0.
+        time = (
+            torch.distributions.Beta(self.time_beta_alpha, self.time_beta_beta)
+            .sample((batch_size,))
+            .to(device=device, dtype=ground_truth_actions.dtype)
+        )
+        time = time * 0.999 + 0.001
+        time_expanded = time.view(batch_size, 1, 1)
+        noisy_actions = (1 - time_expanded) * ground_truth_actions + time_expanded * noise
+        target_velocity = noise - ground_truth_actions
+        time_embeddings = self.time_encoder(time).to(ground_truth_actions.dtype).unsqueeze(1)
+        return dict(
+            noise=noise,
+            noisy_actions=noisy_actions,
+            target_velocity=target_velocity,
+            time=time,
+            diffusion_timestep_embeddings=time_embeddings,
+        )
+
+    def predict_velocity(self, actions_hidden_states):
+        """
+        Predict the velocity field for the current noisy state.
+
+        actions_hidden_states: (B, chunk_len * action_dim, hidden_dim)
+        returns: (B, chunk_len, action_dim)
+        """
+        batch_size = actions_hidden_states.shape[0]
+        rearranged_actions_hidden_states = actions_hidden_states.reshape(batch_size, NUM_ACTIONS_CHUNK, -1)
+        return self.velocity_predictor(rearranged_actions_hidden_states)
