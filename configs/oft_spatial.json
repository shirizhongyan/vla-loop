{
  "base_model": "openvla/openvla-7b",
  "dataset_name": "libero_spatial_no_noops",
  "backbone_quantization_bits": 8,
  "use_lora": true,
  "lora_rank": 32,
  "use_l1_regression": true,
  "use_diffusion": false,
  "use_film": false,
  "num_images_in_input": 1,
  "use_proprio": false,
  "action_chunk_size": 8,
  "action_dimension": 7,
  "batch_size": 1,
  "grad_accumulation_steps": 16,
  "effective_batch_size_single_gpu": 16,
  "learning_rate": 0.0005,
  "num_steps_before_decay": 8000,
  "max_steps": 10000,
  "save_freq": 2500,
  "image_aug": true,
  "gradient_checkpointing": "non-reentrant",
  "gradient_clipping_in_successful_run": false,
  "evaluation": {
    "task_suite_name": "libero_spatial",
    "num_trials_per_task": 50,
    "num_tasks": 10,
    "seed": 7,
    "initial_states_path": "DEFAULT",
    "center_crop": true,
    "load_in_8bit": true,
    "num_open_loop_steps": 8,
    "num_steps_wait": 10,
    "env_img_res": 256
  }
}
